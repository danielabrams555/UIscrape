<Window x:Class="UIScrape.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:viewmodels="clr-namespace:UIScrape.ViewModels"
        xmlns:models="clr-namespace:UIScrape.Models"
        Title="UI Scrape - Windows UI Element Inspector &amp; Interaction Tester"
        Height="800" Width="1300"
        MinHeight="600" MinWidth="900"
        Background="{StaticResource BackgroundBrush}"
        WindowStartupLocation="CenterScreen">

    <Window.DataContext>
        <viewmodels:MainViewModel />
    </Window.DataContext>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header / App Selection -->
        <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}"
                CornerRadius="8" Padding="16" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Target Application:"
                           VerticalAlignment="Center" FontSize="14"
                           FontWeight="SemiBold" Margin="0,0,12,0"/>

                <ComboBox Grid.Column="1"
                          ItemsSource="{Binding Processes}"
                          SelectedItem="{Binding SelectedProcess}"
                          DisplayMemberPath="DisplayName"
                          IsEnabled="{Binding IsLoading, Converter={StaticResource InverseBoolConverter}}"
                          VerticalAlignment="Center"/>

                <Button Grid.Column="2" Content="Refresh List"
                        Command="{Binding LoadProcessesCommand}"
                        Style="{StaticResource PrimaryButton}"
                        Margin="12,0,0,0"/>
            </Grid>
        </Border>

        <!-- Controls Row -->
        <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}"
                CornerRadius="8" Padding="16" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Content="Scan Now"
                        Command="{Binding RefreshElementsCommand}"
                        Style="{StaticResource PrimaryButton}"
                        IsEnabled="{Binding SelectedProcess, Converter={StaticResource NullToBoolConverter}}"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="24,0,0,0" VerticalAlignment="Center">
                    <CheckBox Content="Auto-Refresh"
                              IsChecked="{Binding IsAutoRefreshEnabled}"
                              VerticalAlignment="Center"
                              FontSize="14"/>
                    <TextBlock Text="every" Margin="12,0,8,0" VerticalAlignment="Center"/>
                    <ComboBox Width="60" SelectedValue="{Binding RefreshIntervalSeconds}" SelectedValuePath="Content">
                        <ComboBoxItem Content="1"/>
                        <ComboBoxItem Content="2"/>
                        <ComboBoxItem Content="5"/>
                        <ComboBoxItem Content="10"/>
                    </ComboBox>
                    <TextBlock Text="sec" Margin="8,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>

                <Button Grid.Column="2" Content="{Binding ShowTreeView, Converter={StaticResource ViewModeConverter}}"
                        Command="{Binding ToggleViewCommand}"
                        Style="{StaticResource PrimaryButton}"
                        Margin="24,0,0,0"/>

                <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="24,0,0,0">
                    <TextBlock Text="Filter:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBox Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}"
                             Width="200" Padding="8,6" FontSize="14"/>
                </StackPanel>

                <TextBlock Grid.Column="5" VerticalAlignment="Center" FontSize="14">
                    <Run Text="Elements: "/>
                    <Run Text="{Binding TotalElementCount, Mode=OneWay}" FontWeight="Bold"/>
                </TextBlock>
            </Grid>
        </Border>

        <!-- Main Content Area -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="500"/>
            </Grid.ColumnDefinitions>

            <!-- Element List/Tree -->
            <Border Grid.Column="0" Background="{StaticResource SurfaceBrush}"
                    CornerRadius="8" Margin="0,0,16,0">
                <Grid>
                    <!-- Loading Overlay -->
                    <Border Background="#80FFFFFF" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}"
                            Panel.ZIndex="10" CornerRadius="8">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <ProgressBar IsIndeterminate="True" Width="200" Height="4"/>
                            <TextBlock Text="Scanning UI elements..." Margin="0,12,0,0"
                                       HorizontalAlignment="Center" FontSize="14"/>
                        </StackPanel>
                    </Border>

                    <!-- Tree View -->
                    <TreeView ItemsSource="{Binding UiElements}"
                              Visibility="{Binding ShowTreeView, Converter={StaticResource BoolToVisibilityConverter}}"
                              BorderThickness="0" Padding="8"
                              VirtualizingPanel.IsVirtualizing="True"
                              VirtualizingPanel.VirtualizationMode="Recycling">
                        <TreeView.ItemTemplate>
                            <HierarchicalDataTemplate DataType="{x:Type models:UIElementInfo}"
                                                      ItemsSource="{Binding Children}">
                                <StackPanel Orientation="Horizontal" Margin="2">
                                    <TextBlock Text="{Binding ControlType}" FontWeight="SemiBold"
                                               Foreground="{StaticResource PrimaryBrush}"/>
                                    <TextBlock Text=" - " Visibility="{Binding Name, Converter={StaticResource StringToVisibilityConverter}}"/>
                                    <TextBlock Text="{Binding Name}"
                                               Visibility="{Binding Name, Converter={StaticResource StringToVisibilityConverter}}"/>
                                    <TextBlock Text=" [" Foreground="Gray"
                                               Visibility="{Binding AutomationId, Converter={StaticResource StringToVisibilityConverter}}"/>
                                    <TextBlock Text="{Binding AutomationId}" Foreground="Gray" FontStyle="Italic"
                                               Visibility="{Binding AutomationId, Converter={StaticResource StringToVisibilityConverter}}"/>
                                    <TextBlock Text="]" Foreground="Gray"
                                               Visibility="{Binding AutomationId, Converter={StaticResource StringToVisibilityConverter}}"/>
                                    <TextBlock Text=" (disabled)" Foreground="Red" FontStyle="Italic">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>
                        <TreeView.ItemContainerStyle>
                            <Style TargetType="TreeViewItem">
                                <Setter Property="IsExpanded" Value="False"/>
                                <EventSetter Event="Selected" Handler="TreeViewItem_Selected"/>
                            </Style>
                        </TreeView.ItemContainerStyle>
                    </TreeView>

                    <!-- Flat List View -->
                    <ListView ItemsSource="{Binding FilteredFlatList}"
                              SelectedItem="{Binding SelectedElement}"
                              Visibility="{Binding ShowTreeView, Converter={StaticResource InverseBoolToVisibilityConverter}}"
                              BorderThickness="0"
                              VirtualizingPanel.IsVirtualizing="True"
                              VirtualizingPanel.VirtualizationMode="Recycling">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Type" Width="120"
                                                DisplayMemberBinding="{Binding ControlType}"/>
                                <GridViewColumn Header="Name" Width="200"
                                                DisplayMemberBinding="{Binding Name}"/>
                                <GridViewColumn Header="Automation ID" Width="150"
                                                DisplayMemberBinding="{Binding AutomationId}"/>
                                <GridViewColumn Header="Class" Width="150"
                                                DisplayMemberBinding="{Binding ClassName}"/>
                                <GridViewColumn Header="Depth" Width="60"
                                                DisplayMemberBinding="{Binding Depth}"/>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </Grid>
            </Border>

            <!-- Right Panel: Details + Interaction Testing -->
            <Border Grid.Column="1" Background="{StaticResource SurfaceBrush}"
                    CornerRadius="8">
                <TabControl BorderThickness="0" Background="Transparent" Padding="0">
                    <TabControl.Resources>
                        <Style TargetType="TabItem">
                            <Setter Property="Padding" Value="16,8"/>
                            <Setter Property="FontSize" Value="13"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Style>
                    </TabControl.Resources>

                    <!-- Tab 1: Element Details -->
                    <TabItem Header="Element Details">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
                            <StackPanel>
                                <TextBlock Text="Select an element to view details"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           FontStyle="Italic"
                                           Visibility="{Binding SelectedElement, Converter={StaticResource NullToVisibilityConverter}}"/>

                                <StackPanel Visibility="{Binding SelectedElement, Converter={StaticResource NotNullToVisibilityConverter}}">
                                    <TextBlock Text="{Binding SelectedElement.DisplayName}"
                                               FontSize="14" FontWeight="SemiBold"
                                               TextWrapping="Wrap" Margin="0,0,0,16"/>

                                    <!-- Properties -->
                                    <Border Background="{StaticResource BackgroundBrush}"
                                            CornerRadius="4" Padding="12">
                                        <TextBlock Text="{Binding SelectedElement.Details}"
                                                   FontFamily="Consolas" FontSize="12"
                                                   TextWrapping="Wrap"/>
                                    </Border>

                                    <!-- Value -->
                                    <TextBlock Text="Value:" FontWeight="SemiBold" Margin="0,16,0,4"
                                               Visibility="{Binding SelectedElement.Value, Converter={StaticResource StringToVisibilityConverter}}"/>
                                    <Border Background="{StaticResource BackgroundBrush}"
                                            CornerRadius="4" Padding="12"
                                            Visibility="{Binding SelectedElement.Value, Converter={StaticResource StringToVisibilityConverter}}">
                                        <TextBlock Text="{Binding SelectedElement.Value}"
                                                   FontFamily="Consolas" FontSize="12"
                                                   TextWrapping="Wrap"/>
                                    </Border>

                                    <!-- Tree Path -->
                                    <TextBlock Text="Tree Path:" FontWeight="SemiBold" Margin="0,16,0,4"/>
                                    <Border Background="{StaticResource BackgroundBrush}"
                                            CornerRadius="4" Padding="12">
                                        <TextBox Text="{Binding SelectedElement.TreePath, Mode=OneWay}"
                                                 FontFamily="Consolas" FontSize="11"
                                                 TextWrapping="Wrap" IsReadOnly="True"
                                                 BorderThickness="0" Background="Transparent"/>
                                    </Border>

                                    <!-- Finder Code -->
                                    <TextBlock Text="C# Finder Code:" FontWeight="SemiBold" Margin="0,16,0,4"/>
                                    <Border Background="{StaticResource BackgroundBrush}"
                                            CornerRadius="4" Padding="12">
                                        <TextBox Text="{Binding SelectedElement.FinderCodeSnippet, Mode=OneWay}"
                                                 FontFamily="Consolas" FontSize="11"
                                                 TextWrapping="Wrap" IsReadOnly="True"
                                                 BorderThickness="0" Background="Transparent"
                                                 AcceptsReturn="True"/>
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- Tab 2: Interaction Testing -->
                    <TabItem Header="Interaction Testing">
                        <Grid Margin="16,8,16,16">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="180"/>
                            </Grid.RowDefinitions>

                            <!-- No element selected message -->
                            <TextBlock Grid.Row="0" Grid.RowSpan="5"
                                       Text="Select an element to test interactions"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       FontStyle="Italic"
                                       VerticalAlignment="Center" HorizontalAlignment="Center"
                                       Visibility="{Binding SelectedElement, Converter={StaticResource NullToVisibilityConverter}}"/>

                            <!-- Interaction controls (visible when element selected) -->
                            <StackPanel Grid.Row="0"
                                        Visibility="{Binding SelectedElement, Converter={StaticResource NotNullToVisibilityConverter}}">
                                <TextBlock Text="{Binding SelectedElement.DisplayName}"
                                           FontSize="13" FontWeight="SemiBold"
                                           TextWrapping="Wrap" Margin="0,0,0,8"
                                           TextTrimming="CharacterEllipsis" MaxHeight="40"/>

                                <!-- Category filter -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="Category:" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="12"/>
                                    <ComboBox ItemsSource="{Binding InteractionCategories}"
                                              SelectedItem="{Binding InteractionFilterCategory}"
                                              Width="120" FontSize="12" Padding="6,4"/>
                                    <Button Content="Test Safe Methods"
                                            Command="{Binding TryAllAvailableCommand}"
                                            Style="{StaticResource PrimaryButton}"
                                            Margin="12,0,0,0" FontSize="11" Padding="10,5"
                                            ToolTip="Run all available non-destructive read/info methods on this element"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- Interaction method list -->
                            <ListBox Grid.Row="2"
                                     ItemsSource="{Binding FilteredInteractions}"
                                     SelectedItem="{Binding SelectedInteraction}"
                                     Visibility="{Binding SelectedElement, Converter={StaticResource NotNullToVisibilityConverter}}"
                                     BorderThickness="1" BorderBrush="#E0E0E0"
                                     Margin="0,0,0,8"
                                     VirtualizingPanel.IsVirtualizing="True">
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type models:InteractionMethod}">
                                        <StackPanel Margin="4,3" ToolTip="{Binding ToolTip}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock FontSize="12" FontWeight="SemiBold">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                                                            <Setter Property="Text" Value="{Binding Name}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsAvailable}" Value="False">
                                                                    <Setter Property="Foreground" Value="#BDBDBD"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <Border Background="#E3F2FD" CornerRadius="3" Padding="5,1" Margin="8,0,0,0"
                                                        Visibility="{Binding IsAvailable, Converter={StaticResource BoolToVisibilityConverter}}">
                                                    <TextBlock Text="{Binding Category}" FontSize="10" Foreground="{StaticResource PrimaryBrush}"/>
                                                </Border>
                                                <TextBlock Text=" (needs param)" FontSize="10" Foreground="Gray" VerticalAlignment="Center"
                                                           Margin="4,0,0,0">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding RequiresParameter}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Description}" FontSize="10"
                                                       TextTrimming="CharacterEllipsis" MaxWidth="440">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsAvailable}" Value="False">
                                                                <Setter Property="Foreground" Value="#E0E0E0"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <!-- Parameter input and Execute button -->
                            <StackPanel Grid.Row="3"
                                        Visibility="{Binding SelectedElement, Converter={StaticResource NotNullToVisibilityConverter}}"
                                        Margin="0,0,0,8">
                                <!-- Parameter input (shown when selected interaction needs it) -->
                                <Grid Margin="0,0,0,8"
                                      Visibility="{Binding SelectedInteraction.RequiresParameter, Converter={StaticResource BoolToVisibilityConverter}, FallbackValue=Collapsed}">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"
                                               Text="{Binding SelectedInteraction.ParameterHint}" Margin="0,0,0,4"/>
                                    <TextBox Grid.Row="1"
                                             Text="{Binding InteractionParameter, UpdateSourceTrigger=PropertyChanged}"
                                             Padding="8,6" FontSize="13" FontFamily="Consolas"/>
                                </Grid>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0"
                                            Content="{Binding SelectedInteraction.Name, FallbackValue='Select a method', StringFormat='Execute: {0}'}"
                                            Command="{Binding ExecuteInteractionCommand}"
                                            Style="{StaticResource PrimaryButton}"
                                            HorizontalAlignment="Stretch"
                                            FontSize="13"/>
                                    <Button Grid.Column="1" Content="Clear Log"
                                            Command="{Binding ClearInteractionResultsCommand}"
                                            Margin="8,0,0,0" Padding="12,8"
                                            FontSize="12" Cursor="Hand"/>
                                </Grid>
                            </StackPanel>

                            <!-- Interaction Results Log -->
                            <Border Grid.Row="4" Background="{StaticResource BackgroundBrush}"
                                    CornerRadius="4" Padding="4"
                                    Visibility="{Binding SelectedElement, Converter={StaticResource NotNullToVisibilityConverter}}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Text="Interaction Log" FontWeight="SemiBold"
                                               FontSize="12" Margin="4,2,0,4"/>
                                    <ListView Grid.Row="1"
                                              ItemsSource="{Binding InteractionResults}"
                                              BorderThickness="0" Background="Transparent"
                                              FontFamily="Consolas" FontSize="11"
                                              VirtualizingPanel.IsVirtualizing="True"
                                              ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                        <ListView.ItemTemplate>
                                            <DataTemplate DataType="{x:Type models:InteractionResult}">
                                                <TextBlock Text="{Binding Summary}" TextWrapping="Wrap">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="#4CAF50"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Success}" Value="False">
                                                                    <Setter Property="Foreground" Value="#F44336"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                </Grid>
                            </Border>
                        </Grid>
                    </TabItem>
                </TabControl>
            </Border>
        </Grid>

        <!-- Status Bar -->
        <Border Grid.Row="3" Background="{StaticResource SurfaceBrush}"
                CornerRadius="8" Padding="16,12" Margin="0,16,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="{Binding StatusMessage}"
                           VerticalAlignment="Center" FontSize="13"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Ellipse Width="10" Height="10" Margin="0,0,8,0">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="#4CAF50"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsAutoRefreshEnabled}" Value="False">
                                        <Setter Property="Fill" Value="#9E9E9E"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock VerticalAlignment="Center" FontSize="13">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="Live"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsAutoRefreshEnabled}" Value="False">
                                        <Setter Property="Text" Value="Paused"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
